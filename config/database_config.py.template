"""
Database Configuration Template

Copy this file to database_config.py and update with your actual database credentials.
Never commit the actual database_config.py file to version control.
"""

import os

def get_db_config():
    """
    Return database configuration.
    
    You can either:
    1. Set the values directly in this function (not recommended for production)
    2. Use environment variables (recommended)
    """
    
    # Option 1: Direct configuration (development only)
    config = {
        'host': 'localhost',
        'user': 'your_username',
        'password': 'your_password',
        'database': 'your_database_name',
        'port': 3306
    }
    
    # Option 2: Environment variables (recommended)
    # Uncomment the following lines and comment out the above config
    # config = {
    #     'host': os.getenv('DB_HOST', 'localhost'),
    #     'user': os.getenv('DB_USER', 'root'),
    #     'password': os.getenv('DB_PASSWORD'),
    #     'database': os.getenv('DB_NAME'),
    #     'port': int(os.getenv('DB_PORT', 3306))
    # }
    
    return config

def create_db_connection():
    """Create SQLAlchemy engine with proper error handling."""
    try:
        import sqlalchemy
        from urllib.parse import quote_plus
        
        config = get_db_config()
        
        # Validate required fields
        required_fields = ['host', 'user', 'password', 'database']
        for field in required_fields:
            if not config.get(field):
                raise ValueError(f"Missing required database configuration: {field}")
        
        # URL-encode password to handle special characters
        encoded_password = quote_plus(config['password'])
        
        connection_string = (
            f"mysql+pymysql://{config['user']}:{encoded_password}"
            f"@{config['host']}:{config['port']}/{config['database']}"
        )
        
        engine = sqlalchemy.create_engine(
            connection_string,
            pool_pre_ping=True,  # Verify connections before use
            pool_recycle=3600,   # Recycle connections every hour
        )
        
        return engine
        
    except Exception as e:
        print(f"Error connecting to database: {e}")
        return None